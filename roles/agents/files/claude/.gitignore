# Ignore everything by default
*

# Keep configuration files
!.gitignore
!CLAUDE.md
!settings.json
!keybindings.json

# Keep rules
!rules/
!rules/**

# Keep agents
!agents/
!agents/**

# Keep commands (slash commands)
!commands/
!commands/**

# Keep skills
!skills/
!skills/**

# Keep powerline config
!.claude-powerline.json

# Keep plugin config (not runtime data)
!plugins/
!plugins/config.json
