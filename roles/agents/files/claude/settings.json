{
  "permissions": {
    "allow": [
      "Bash(/Users/gracetang/.claude/skills/remindme/scripts/remind.sh *)",
      "Bash(direnv allow)",
      "Bash(echo \"terminal-notifier*)",
      "Bash(echo *| at *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git diff *|*)",
      "Bash(git log *)",
      "Bash(git log *|*)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(hdev build:common)",
      "Bash(hdev check-types)",
      "Bash(hdev gql:*)",
      "Bash(hdev install:*)",
      "Bash(hdev lint:*)",
      "Bash(hdev -F @hex/ai-sdk lint:*)",
      "Bash(hdev -F @hex/client lint:*)",
      "Bash(hdev -F @hex/common lint:*)",
      "Bash(hdev -F @hex/dev-tools lint:*)",
      "Bash(hdev -F @hex/server lint:*)",
      "Bash(hdev -F @hex/server-db lint:*)",
      "Bash(hdev -F @hex/service-common lint:*)",
      "Bash(hdev -F @hex/sidecar lint:*)",
      "Bash(hdev -F @hex/stripe-api lint:*)",
      "Bash(hdev:*)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(sdm status:*)",
      "Bash(system_profiler SPBluetoothDataType)",
      "Bash(tmuxinator start worktree:*)",
      "Read(.claude/**)",
      "Read(claude/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code is done\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs permission\" with title \"Claude Code\" sound name \"Ping\"'"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a' > /dev/tty 2>/dev/null; terminal-notifier -title 'Claude Code' -message '$CLAUDE_NOTIFICATION_MESSAGE' -sound default 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/cms internal hook --socket /var/folders/q7/bys9dr7d1wj1q0f3689g_sdr0000gn/T/cms-501.sock notification",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/cms internal hook --socket /var/folders/q7/bys9dr7d1wj1q0f3689g_sdr0000gn/T/cms-501.sock pre-tool-use",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/cms internal hook --socket /var/folders/q7/bys9dr7d1wj1q0f3689g_sdr0000gn/T/cms-501.sock session-end",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/cms internal hook --socket /var/folders/q7/bys9dr7d1wj1q0f3689g_sdr0000gn/T/cms-501.sock session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/cms internal hook --socket /var/folders/q7/bys9dr7d1wj1q0f3689g_sdr0000gn/T/cms-501.sock stop",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/cms internal hook --socket /var/folders/q7/bys9dr7d1wj1q0f3689g_sdr0000gn/T/cms-501.sock prompt-submit",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y @owloops/claude-powerline@latest --config=~/.claude/.claude-powerline.json"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
